---
import { Image } from 'astro:assets';

import { formatDate, getInitials, getLevelMeta } from '@lib/utils';
import { getCoverImage, resolveCover } from '@lib/images';

import type { getEvents } from '@lib/store';

interface ContentBlock {
    content: string;
    type: 'h' | 'li' | 'p';
}

interface Props {
    event: Awaited<ReturnType<typeof getEvents>>[number];
}

const { event } = Astro.props;

const { cover = '', date, level = '', location, time, title } = event;

const coverImage = getCoverImage(cover);
const initials = getInitials(title);
const meta = getLevelMeta(level);
const rawBlocks = parseEventContent(event.content);
const who = level || 'Everyone';

const groupedBlocks: Array<{ items: string[]; type: ContentBlock['type'] }> = [];

function parseEventContent(markdown: string) {
    const blocks: ContentBlock[] = [];

    for (const line of markdown.split('\n')) {
        const trimmed = line.trim();

        if (!trimmed) continue;

        if (trimmed.startsWith('## ')) blocks.push({ content: trimmed.slice(3), type: 'h' });
        else if (trimmed.startsWith('- ')) blocks.push({ content: trimmed.slice(2), type: 'li' });
        else blocks.push({ content: trimmed, type: 'p' });
    }

    return blocks;
}

for (const block of rawBlocks) {
    if (block.type === 'li' && groupedBlocks.length && groupedBlocks[groupedBlocks.length - 1].type === 'li') {
        groupedBlocks[groupedBlocks.length - 1].items.push(block.content);
    } else {
        groupedBlocks.push({ items: [block.content], type: block.type });
    }
}
---

<article class="event">
    <div class="shell">
        <a
            class="event__back"
            href="/events"
        >
            <span aria-hidden="true">&larr;</span>
            <span data-i18n="All events">All events</span>
        </a>
        <h1 class="event__title" data-scroll>{title}</h1>
        <dl
            class="event__meta"
            data-scroll
        >
            <div>
                <dt class="event__meta-label" data-i18n="Date">Date</dt>
                <dd class="event__meta-value">
                    <time data-i18n-date={date} datetime={date}>{formatDate(date)}</time>
                </dd>
            </div>
            {time && (
                <div>
                    <dt class="event__meta-label" data-i18n="Time">Time</dt>
                    <dd class="event__meta-value">{time}</dd>
                </div>
            )}
            <div>
                <dt class="event__meta-label" data-i18n="Location">Location</dt>
                <dd class="event__meta-value" data-i18n={location}>{location}</dd>
            </div>
            <div>
                <dt class="event__meta-label" data-i18n="Who">Who</dt>
                <dd class="event__meta-value" data-i18n={who}>{who}</dd>
            </div>
        </dl>
        <div
            class="event__cover"
            data-scroll
            style={`background:${meta.cover};color:${meta.ink}`}
        >
            {coverImage && <Image class="event__cover-image" alt="" priority sizes="(min-width: 1408px) 1152px, 100vw" src={coverImage} widths={[640, 960, 1_250]} />}
            {!coverImage && cover && <img class="event__cover-image" alt="" decoding="async" src={resolveCover(cover)} />}
            {!coverImage && !cover && <span class="event__cover-initials" aria-hidden="true">{initials}</span>}
        </div>
        <div
            class="event__content prose"
            data-scroll
        >
            {groupedBlocks.map((group) => {
                if (group.type === 'h') return <h2>{group.items[0]}</h2>;
                if (group.type === 'li') return <ul>{group.items.map(item => <li>{item}</li>)}</ul>;

                return <p>{group.items[0]}</p>;
            })}
        </div>
        <div
            class="event__actions"
            data-scroll
        >
            <a
                class="button event__action"
                href={`/?event=${encodeURIComponent(title)}#contact`}
            >
                <span data-i18n="Register">Register</span>
            </a>
            <a
                class="button button--outline event__action"
                href="/events"
            >
                <span data-i18n="Back to all">Back to all</span>
            </a>
        </div>
    </div>
</article>

<style>
    .event {
        padding-bottom: var(--section-padding);
        padding-top: calc(var(--header-height) + clamp(28px, calc(22.67px + 1.67vw), 44px));
    }

    .event__actions {
        align-items: center;
        border-top: 1px solid var(--color-silver);
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        padding-top: 36px;
    }

    .event__back {
        align-items: center;
        color: var(--color-slate-faint);
        display: inline-flex;
        font-size: 16px;
        font-weight: 600;
        gap: 8px;
        margin-bottom: 28px;
        text-decoration: none;
        transition:
            box-shadow var(--duration-fast) ease,
            color var(--duration-fast) ease,
            opacity var(--duration-fast) ease;
    }

    .event__back:active {
        opacity: 0.7;
    }

    .event__back:focus-visible {
        box-shadow: 0 0 0 3px var(--color-cobalt-20);
        outline: none;
    }

    .event__back:hover {
        color: var(--color-cobalt);
    }

    .event__content {
        margin-bottom: 48px;
    }

    .event__cover {
        align-items: center;
        aspect-ratio: 2.5;
        border: 1px solid var(--color-silver);
        border-radius: 16px;
        display: flex;
        justify-content: center;
        margin-bottom: 44px;
        overflow: hidden;
    }

    .event__cover-image {
        height: 100%;
        object-fit: cover;
        object-position: left top;
        width: 100%;
    }

    .event__cover-initials {
        font-family: var(--font-heading);
        font-size: clamp(60px, calc(40px + 6.25vw), 120px);
        font-weight: 700;
        letter-spacing: -0.03em;
        opacity: 0.26;
    }

    .event__meta {
        border-bottom: 1px solid var(--color-silver);
        border-top: 1px solid var(--color-silver);
        display: flex;
        flex-wrap: wrap;
        gap: 14px 40px;
        margin-bottom: 36px;
        padding: 22px 0;
    }

    .event__meta-label {
        color: var(--color-slate-ghost);
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        margin: 0 0 6px;
        text-transform: uppercase;
    }

    .event__meta-value {
        color: var(--color-slate);
        font-size: 16px;
        font-weight: 600;
        margin: 0;
        overflow-wrap: anywhere;
    }

    .event__title {
        color: var(--color-slate);
        font-size: clamp(32px, calc(26.67px + 1.67vw), 48px);
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.06;
        margin: 0 0 28px;
        overflow-wrap: anywhere;
        text-wrap: balance;
    }

    .prose {
        overflow-wrap: anywhere;
    }

    .prose h2 {
        font-size: clamp(20px, calc(18.67px + 0.42vw), 24px);
        font-weight: 600;
        letter-spacing: -0.01em;
        margin: 0 0 14px;
        padding-top: 34px;
    }

    .prose li {
        align-items: flex-start;
        color: var(--color-slate-soft);
        display: flex;
        font-size: 16px;
        gap: 12px;
        line-height: 1.6;
    }

    .prose li::before {
        background: var(--color-cobalt);
        border-radius: 50%;
        content: '';
        flex: none;
        height: 6px;
        transform: translateY(8px);
        width: 6px;
    }

    .prose p {
        color: var(--color-slate-soft);
        font-size: 16px;
        line-height: 1.7;
        margin: 0 0 18px;
    }

    .prose ul {
        display: flex;
        flex-direction: column;
        gap: 12px;
        list-style: none;
        margin: 0 0 18px;
        padding: 0;
    }

    @media (max-width: 768px) {
        .event__action {
            justify-content: center;
            width: 100%;
        }

        .event__actions {
            flex-direction: column;
        }
    }
</style>
