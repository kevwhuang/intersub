<svg
    class="curve"
    aria-hidden="true"
    preserveAspectRatio="none"
    viewBox="0 0 300 1000"
>
    <path class="curve__path" d="M 30 60 C 30 170, 200 170, 200 280 S 30 390, 30 500 S 200 610, 200 720 S 30 830, 30 960" />
    <circle class="curve__dot" cx="30" cy="60" r="4" />
    <circle class="curve__dot" cx="200" cy="280" r="4" />
    <circle class="curve__dot" cx="30" cy="500" r="4" />
    <circle class="curve__dot" cx="200" cy="720" r="4" />
</svg>

<style>
    .curve {
        height: calc(100% + 2 * var(--section-padding));
        left: 0;
        pointer-events: none;
        position: absolute;
        top: calc(-1 * var(--section-padding));
        width: clamp(100px, calc(53.33px + 14.58vw), 240px);
    }

    .curve__dot {
        fill: color-mix(in srgb, var(--color-cobalt) 40%, var(--color-silver-hover));
    }

    .curve__path {
        fill: none;
        opacity: 0.7;
        stroke: color-mix(in srgb, var(--color-cobalt) 25%, var(--color-silver-hover));
        stroke-linecap: round;
        stroke-width: 1.5;
    }

    @media (max-width: 768px) {
        .curve {
            display: none;
        }
    }
</style>
